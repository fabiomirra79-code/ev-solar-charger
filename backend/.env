# ============================================
# EV SOLAR CHARGER - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to version control!

# ============================================
# SMARTLIFE / TUYA CONFIGURATION
# ============================================
# SmartLife app credentials
SMARTLIFE_USERNAME=fabiomirra79@gmail.com
SMARTLIFE_PASSWORD=Diavoletto1
SMARTLIFE_DEVICE_ID=Byd Charger
SMARTLIFE_REGION=EU

# Optional: Tuya Cloud API (for direct API integration instead of app)
# Get these from: https://iot.tuya.com/
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
TUYA_DEVICE_ID=

# ============================================
# SUNPOWER CONFIGURATION
# ============================================
# SunPower/Maxeon OAuth2 credentials
# Portal: https://dashboard.reserve.sunpower.maxeon.com/
SUNPOWER_CLIENT_ID=fabiomirra79@gmail.com
SUNPOWER_CLIENT_SECRET=Momentum.1
SUNPOWER_REFRESH_TOKEN=
SUNPOWER_SYSTEM_ID=

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection string
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://user:password@localhost:5432/ev_solar_charger
DATABASE_ECHO=False

# ============================================
# API SERVER CONFIGURATION
# ============================================
# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True
DEBUG=True

# CORS settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://localhost:8081"]

# ============================================
# AUTOMATION RULES
# ============================================
# Minimum solar surplus required to start charging (kW)
MIN_SURPLUS_FOR_CHARGE=0.5

# Target battery charge level (%)
TARGET_CHARGE_LEVEL=80

# Hysteresis: stop charging if surplus drops below this percentage of MIN_SURPLUS
SURPLUS_HYSTERESIS=0.8

# Polling interval for API updates (seconds)
POLLING_INTERVAL=5

# Automation enabled by default
AUTOMATION_ENABLED=True

# ============================================
# CHARGING PARAMETERS
# ============================================
# Maximum charging power (kW)
MAX_CHARGE_POWER=7.4

# Minimum charging power (kW)
MIN_CHARGE_POWER=1.4

# Target charging efficiency (%)
CHARGING_EFFICIENCY=95

# ============================================
# LOGGING
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/ev_solar_charger.log

# Enable JSON logging
LOG_JSON=False

# ============================================
# NOTIFICATIONS (Optional)
# ============================================
# Email notifications
EMAIL_ENABLED=False
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_TO=recipient@gmail.com

# Webhook notifications
WEBHOOK_ENABLED=False
WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================
# CACHE & STORAGE
# ============================================
# Redis cache (optional)
REDIS_ENABLED=False
REDIS_URL=redis://localhost:6379/0

# Data retention (days)
DATA_RETENTION_DAYS=90

# ============================================
# SECURITY
# ============================================
# API key for authentication (optional)
API_KEY=your-secure-api-key-here

# JWT secret for token generation
JWT_SECRET=your-jwt-secret-key-change-this

# Encryption key for sensitive data
ENCRYPTION_KEY=your-encryption-key-here

# ============================================
# MOBILE APP CONFIGURATION
# ============================================
# Backend URL for mobile app
MOBILE_API_URL=http://localhost:8000

# App version
APP_VERSION=1.0.0

# ============================================
# FEATURE FLAGS
# ============================================
# Enable manual charging control
MANUAL_CHARGE_ENABLED=True

# Enable automatic charging
AUTO_CHARGE_ENABLED=True

# Enable night charging (optional off-peak mode)
NIGHT_CHARGE_ENABLED=False
NIGHT_CHARGE_START=22:00
NIGHT_CHARGE_END=06:00

# Enable temperature monitoring
TEMP_MONITORING_ENABLED=False

# ============================================
# DEVELOPMENT & TESTING
# ============================================
# Use mock data for testing (no real API calls)
USE_MOCK_DATA=False

# Simulate solar production (for testing)
MOCK_SOLAR_POWER=3.8

# Simulate charger battery level (for testing)
MOCK_BATTERY_LEVEL=72
