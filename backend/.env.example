# SmartLife / Tuya Configuration
SMARTLIFE_USERNAME=your_email@gmail.com
SMARTLIFE_PASSWORD=your_password
SMARTLIFE_DEVICE_ID=Your_Device_ID
SMARTLIFE_REGION=EU

# SunPower Configuration
SUNPOWER_CLIENT_ID=your_client_id
SUNPOWER_CLIENT_SECRET=your_secret
SUNPOWER_REFRESH_TOKEN=your_token

# Database
DATABASE_URL=postgres://user:password@localhost:5432/ev_solar_charger

# API
API_PORT=8000
API_HOST=0.0.0.0

# Solar Thresholds (kW)
MIN_SURPLUS_FOR_CHARGE=0.5
TARGET_CHARGE_LEVEL=80
